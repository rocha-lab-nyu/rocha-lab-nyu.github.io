---
layout: page
---
<style>
  .profile-socials {
    margin-top: 0.6rem;
    font-size: 1.3rem;
  }
  .profile-socials a {
    margin-right: 0.7rem;
    color: var(--global-theme-color);
  }
  .profile-socials a:hover {
    color: var(--global-text-color);
  }
  /* Make the "You?" join image a bit larger than the square member photos
     (the fox is transparent line-art, so it reads small at the default width). */
  @media (min-width: 576px) {
    .profile.join-image {
      width: 42%;
    }
  }

  /* Extra people-page sections (alumni, lab life) below the member profiles. */
  .people-extra {
    margin-top: 3.5rem;
  }
  .people-extra h2 {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--global-theme-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding-bottom: 0.35rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }
  .people-extra > h2:first-child {
    margin-top: 0;
  }

  /* Alumni */
  .alumni-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .alumni-table th,
  .alumni-table td {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--global-divider-color);
    vertical-align: top;
  }
  .alumni-table th {
    color: var(--global-text-color-light);
    font-weight: 600;
  }
  .alumni-note {
    color: var(--global-text-color-light);
  }

  /* Lab life photo gallery */
  .lab-life-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .lab-life-gallery figure {
    margin: 0;
  }
  .lab-life-gallery picture,
  .lab-life-gallery img {
    display: block;
    width: 100%;
  }
  .lab-life-gallery img {
    height: 210px;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.2s ease;
  }
  .lab-life-gallery img:hover {
    transform: scale(1.02);
  }
  .lab-life-caption {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  .lab-life-video {
    display: block;
    margin: 1rem auto 0;
    max-height: 560px;
    max-width: 100%;
    border-radius: 12px;
    background: #000;
  }
</style>
<div class="post">
  <article>
    {% if page.profiles %}
      {% for profile in page.profiles %}
        <hr>
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
          {% if profile.social %}
            {% assign s = site.data.socials %}
            <div class="profile-socials">
              {% if s.x_username -%}
                <a href="https://x.com/{{ s.x_username }}" title="X" target="_blank" rel="noopener noreferrer"
                  ><i class="fa-brands fa-x-twitter"></i
                ></a>
              {%- endif %}
              {% if s.bluesky_username -%}
                <a href="https://bsky.app/profile/{{ s.bluesky_username }}" title="Bluesky" target="_blank" rel="noopener noreferrer"
                  ><i class="fa-brands fa-bluesky"></i
                ></a>
              {%- endif %}
              {% if s.linkedin_username -%}
                <a href="https://www.linkedin.com/in/{{ s.linkedin_username }}" title="LinkedIn" target="_blank" rel="noopener noreferrer"
                  ><i class="fa-brands fa-linkedin"></i
                ></a>
              {%- endif %}
              {% if s.scholar_userid -%}
                <a
                  href="https://scholar.google.com/citations?user={{ s.scholar_userid }}"
                  title="Google Scholar"
                  target="_blank"
                  rel="noopener noreferrer"
                  ><i class="ai ai-google-scholar"></i
                ></a>
              {%- endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}

      <!-- Open invitation -->
      <hr>
      <div class="profile float-left join-image">
        <img class="img-fluid" src="{{ '/assets/img/TRANSPARENT.gif' | relative_url }}" alt="Join the Rocha Lab">
      </div>
      <div class="clearfix">
        <p><strong>You?</strong></p>
        <p>
          Ideal lab members will have strong background in at least one area of
          computational biology, field ecology, mammal organismic biology,
          evolutionary genetics and genome sciences. Applicants to postdoctoral
          roles will, in addition, be expected to have a publication record in
          relevant journals in genetics, ecology and evolution.
        </p>
        <p>
          If you would like to join the lab, read about
          <a href="{{ '/joinus/' | relative_url }}">joining us</a>.
        </p>
      </div>

      {% if content != blank %}
        <div class="people-extra">{{ content }}</div>
      {% endif %}
    {% endif %}
  </article>
</div>
